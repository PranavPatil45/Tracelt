# Environment Configuration for Tracelt FastAPI Backend
PROJECT_NAME="Tracelt API"
VERSION="1.0.0"
DEBUG=True

# Security & JWT Configuration
SECRET_KEY="tracelt_development_super_secret_jwt_key_change_in_production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (Relative paths automatically resolve to canonical backend/tracelt.db)
DATABASE_URL="sqlite:///./tracelt.db"

# CORS Configuration
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000","http://127.0.0.1:3000"]

# Gemini AI Visual Matching Configuration
GEMINI_API_KEY="your-api-key-here"
GEMINI_MODEL="gemini-3.1-flash-lite"
VISUAL_CANDIDATE_THRESHOLD=50
MAX_VISUAL_COMPARISONS=5

